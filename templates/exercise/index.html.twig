{% extends 'base.html.twig' %}

{% block title %}TRAINING PLAN{% endblock %}

{% block body %}
    <h1 class="page-title">Ćwiczenia to do:</h1>
    
    <form class="add-exercise-form" method="POST" action="">
        <input class="name-exercise-input" type="text" name="name" placeholder="Nazwa ćwiczenia..." required>
        <input class="reps-exercise-input" type="number" name="reps" placeholder="Reps" required>
        <button class="add-exercise-btn" type="submit">Dodaj ćwiczenie</button>
    </form>

    <hr>

    <h2 class="section-title">Moje ćwiczenia:</h2>
      <ul class="exercise-list">
        {% for exercise in exercises %}
            <li class="exercise-item">
                <strong class="col-name">{{ exercise.name }}</strong>
                <span class="col-reps">- {{ exercise.reps }} powt.</span>
                <span class="col-status current-status">(Status: {{ exercise.isDone ? 'Zrobione' : 'Do zrobienia' }})</span>
                
                <button class="mark-done-btn" data-url="{{ path('app_exercise_mark_done', {'id': exercise.id}) }}">
                    {{ exercise.isDone ? 'Cofnij' : 'JUST DO IT!' }}
                </button>
            </li>
        {% else %}
            <li class="exercise-item empty-msg">Brak ćwiczeń. Dodaj swój pierwszy trening!</li>
        {% endfor %}
    </ul>
    
    <script type="module">
        import $ from 'jquery';

        $(document).ready(function() {
            $('.mark-done-btn').on('click', function(e) {
                e.preventDefault(); 
                
                const $btn = $(this);
                const url = $btn.data('url');
                const $status = $btn.siblings('.current-status');
                
                // blokowanie przycisku, żeby nie spamować kliknięciami
                $btn.prop('disabled', true);

                $.ajax({
                    url: url,
                    method: 'POST',
                    success: function(response) {
                        if (response.status === 'success') {
                            if ($btn.text().trim() === 'JUST DO IT!') {
                                $btn.text('Cofnij');
                                $status.text('(Status: Zrobione)');
                            } else {
                                $btn.text('JUST DO IT!');
                                $status.text('(Status: Do zrobienia)');
                            }
                        }
                    },
                    error: function() {
                        alert('Wystąpił błąd podczas zmiany statusu.');
                    },
                    complete: function() {
                        $btn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
{% endblock %}