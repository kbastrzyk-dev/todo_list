{% extends 'base.html.twig' %}

{% block title %}Hello ExerciseController!{% endblock %}

{% block body %}
    <h1>Ćwiczenia to do:</h1>
    
    <form method="POST" action="">
        <input type="text" name="name" placeholder="Nazwa ćwiczenia..." required>
        <input type="number" name="reps" placeholder="Reps" required>
        <button type="submit">Dodaj ćwiczenie</button>
    </form>

    <hr>

    <h2>Moje ćwiczenia:</h2>
    <ul>
        {% for exercise in exercises %}
            <li>
                <strong>{{ exercise.name }}</strong> - {{ exercise.reps }} powt. 
                <b class="current-status">(Status: {{ exercise.isDone ? 'Zrobione' : 'Do zrobienia' }})</b>
                
                <button class="mark-done-btn" data-url="{{ path('app_exercise_mark_done', {'id': exercise.id}) }}">
                    {{ exercise.isDone ? 'Cofnij' : 'JUST DO IT!' }}
                </button>
            </li>
        {% else %}
            <li>Brak ćwiczeń. Dodaj swój pierwszy trening!</li>
        {% endfor %}
    </ul>
    
    <script type="module">
        import $ from 'jquery';

        $(document).ready(function() {
            $('.mark-done-btn').on('click', function(e) {
                e.preventDefault(); 
                
                const $btn = $(this);
                const url = $btn.data('url');
                const $status = $btn.siblings('.current-status');
                
                // blokowanie przycisku, żeby nie spamować kliknięciami
                $btn.prop('disabled', true);

                $.ajax({
                    url: url,
                    method: 'POST',
                    success: function(response) {
                        if (response.status === 'success') {
                            if ($btn.text().trim() === 'JUST DO IT!') {
                                $btn.text('Cofnij');
                                $status.text('(Status: Zrobione)');
                            } else {
                                $btn.text('JUST DO IT!');
                                $status.text('(Status: Do zrobienia)');
                            }
                        }
                    },
                    error: function() {
                        alert('Wystąpił błąd podczas zmiany statusu.');
                    },
                    complete: function() {
                        $btn.prop('disabled', false);
                    }
                });
            });
        });
    </script>
{% endblock %}